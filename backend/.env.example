PORT=3000

# === MODE DATABASE ===
# sqlite = jalan langsung tanpa install apa-apa (buat tugas/demo lokal)
# mysql  = buat XAMPP / hosting (isi bagian MYSQL_* di bawah)
DB_DRIVER=sqlite
SQLITE_FILE=./data/absensi.db

# === Kalau pakai MySQL / XAMPP ===
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=absensi_db

# === Login admin panel (/admin) ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=ganti-secret-ini-di-production
